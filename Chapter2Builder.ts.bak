}

function consolidateEvidence(analisisData: any) {
    const themesMap = new Map<string, any>();
    const prioritasData = analisisData.prioritas || [];
    const maxLen = Math.max(
        prioritasData.length,
        analisisData.tujuan ? analisisData.tujuan.length : 0,
        analisisData.program ? analisisData.program.length : 0
    );

    let maxScore = 0;

    for (let i = 0; i < maxLen; i++) {
        let p = prioritasData[i] || {};
        let t = analisisData.tujuan && analisisData.tujuan[i] ? analisisData.tujuan[i] : null;
        let prog = analisisData.program && analisisData.program[i] ? analisisData.program[i] : null;

        let isu = p.name || '';
        let program = prog ? (typeof prog === 'string' ? prog : prog.nama) : '';
        let sasaran = typeof t === 'string' ? t : (t ? t.name || '' : '');
        let combined = [isu, program, sasaran].join(' ');
        if (!combined.trim() || combined.includes('Data tidak tersedia')) continue;

        let theme = getTheme(combined);
        
        // Extract raw score safely
        let rawScore: number | '-' = '-';
        if (typeof p.priorityScore === 'number') {
            rawScore = p.priorityScore;
        } else if (typeof p.priorityScore === 'string' && !isNaN(Number(p.priorityScore))) {
            rawScore = Number(p.priorityScore);
        }
        
        if (typeof rawScore === 'number' && rawScore > maxScore) {
            maxScore = rawScore;
        }

        if (!themesMap.has(theme)) {
            themesMap.set(theme, { theme, skor: rawScore });
        } else {
            let existing = themesMap.get(theme);
            if (rawScore !== '-' && existing.skor === '-') {
                existing.skor = rawScore;
            } else if (rawScore !== '-' && typeof existing.skor === 'number' && rawScore > existing.skor) {
                existing.skor = rawScore;
            }
        }
    }
    
    return Array.from(themesMap.values()).map(t => {
        let normalizedSkor = '-';
        if (typeof t.skor === 'number' && maxScore > 0) {
            const norm = Math.round((t.skor / maxScore) * 100);
            let label = '';
            if (norm >= 80) label = 'Tinggi';
            else if (norm >= 60) label = 'Sedang';
            else label = 'Rendah';
            normalizedSkor = `${norm} (${label})`;
        } else if (typeof t.skor === 'number' && maxScore === 0) {
            normalizedSkor = `0 (Rendah)`;
        }
        
        return { ...t, ...synthesizeTheme(t.theme), skor: normalizedSkor };
    });
}

export class Chapter2Builder {
  private referenceBuilder = new ReferenceBuilder();

  public build(kg: KnowledgeGraph, settings: any = {}): DocumentChapter {

    const analisisData = settings?.analisis?.data || {};
    const swotCount = (analisisData.kekuatan?.length || 0) + (analisisData.kelemahan?.length || 0) + (analisisData.peluang?.length || 0) + (analisisData.tantangan?.length || 0);
    const irbCount = analisisData.prioritas?.length || 0;
    const objCount = analisisData.tujuan?.length || 0;
    const progCount = analisisData.program?.length || 0;
    const actCount = analisisData.kegiatan?.length || 0;
    
    let budgetCount = 0;
    const rp = settings?.relationalPlanning;
    if (rp && rp.annualPlans) {
       ['Y1', 'Y2', 'Y3', 'Y4'].forEach(y => {
          budgetCount += (rp.annualPlans[y]?.rkas?.length || 0);
       });
    }

    console.log("===================================");
    console.log("PLANNINGRESULT AUDIT");
    console.log("===================================");
    console.log(`PlanningResult.swot ${swotCount}`);
    console.log(`PlanningResult.irb ${irbCount}`);
    console.log(`PlanningResult.objectives ${objCount}`);
    console.log(`PlanningResult.programs ${progCount}`);
    console.log(`PlanningResult.activities ${actCount}`);
    console.log(`PlanningResult.budgets ${budgetCount}`);
    console.log("===================================");
    console.log("CHAPTER BINDING");
    console.log("===================================");
    console.log(`2.3 received ${irbCount} records`);
    console.log(`2.4 received ${swotCount} records`);
    console.log(`2.5 received ${irbCount} records`);
    console.log(`2.6 received ${objCount} records`);

    const sections: DocumentSection[] = [];
    const allReferences: string[] = [];

    // 2.1 Kondisi Umum Sekolah
    sections.push({
      id: generateId('DocumentSection'),
      title: '2.1 Kondisi Umum Sekolah',
      paragraphs: [
        'Penyusunan dokumen Rencana Kerja Jangka Menengah (RKJM) ini diawali dengan pelaksanaan evaluasi kelembagaan yang bersumber dari data objektif Rapor Pendidikan. Langkah diagnostik ini sangat esensial bagi satuan pendidikan untuk memetakan capaian pemenuhan Standar Nasional Pendidikan secara terukur, transparan, dan akuntabel. Melalui pembacaan data yang komprehensif, tim pengembang sekolah dapat mengidentifikasi berbagai tren kinerja, baik pada aspek literasi, numerasi, karakter peserta didik, maupun kualitas lingkungan belajar. Pengukuran yang sistematis ini memastikan bahwa setiap kebijakan perencanaan yang digagas tidak didasarkan pada asumsi semata, melainkan berpijak pada realitas empiris yang secara akurat mencerminkan dinamika layanan pendidikan saat ini.',
        'Lebih jauh, profil capaian standar ini berfungsi sebagai instrumen navigasi strategis yang memberikan gambaran utuh mengenai posisi kelembagaan kita di tengah tuntutan transformasi pendidikan nasional. Analisis data capaian kinerja ini memfasilitasi manajemen sekolah dalam memahami konstelasi mutu pembelajaran yang tengah berlangsung, sekaligus mendeteksi area-area spesifik yang memerlukan atensi perbaikan. Transformasi paradigma evaluasi ini mendorong seluruh ekosistem sekolah untuk membudayakan refleksi berbasis data, sehingga setiap inisiatif pengembangan kelembagaan pada masa mendatang dapat diformulasikan dengan tingkat presisi yang tinggi dan berorientasi penuh pada peningkatan mutu hasil belajar peserta didik secara berkelanjutan.'
      ],
      references: []
    });

    // 2.2 Ringkasan Hasil Rapor Pendidikan
    sections.push({
      id: generateId('DocumentSection'),
      title: '2.2 Ringkasan Hasil Rapor Pendidikan',
      paragraphs: [
        'Menindaklanjuti pemetaan profil kinerja secara makro, satuan pendidikan melakukan pendalaman analitis melalui kerangka evaluasi internal yang terstruktur. Evaluasi ini difokuskan untuk membedah secara kritis determinan yang berkontribusi terhadap pencapaian mutu saat ini, sekaligus mengurai berbagai hambatan sistemik yang masih mengendap dalam tata kelola operasional sekolah. Proses penelusuran mandiri ini melibatkan partisipasi aktif dari seluruh elemen pendidik dan tenaga kependidikan guna memperoleh perspektif yang komprehensif mengenai efektivitas proses pembelajaran, ketersediaan sarana prasarana penunjang, hingga efisiensi manajemen pembiayaan. Dengan demikian, potret kondisi internal sekolah dapat tergambar secara holistik dan proporsional.',
        'Hasil kristalisasi dari proses evaluasi internal tersebut selanjutnya memberikan implikasi strategis yang sangat krusial bagi penentuan arah kebijakan sekolah ke depan. Tinjauan reflektif ini membuktikan bahwa perbaikan berkelanjutan membutuhkan intervensi yang menyentuh ranah kultural dan struktural, bukan sekadar pemenuhan administratif belaka. Oleh karena itu, fokus Rencana Kerja Jangka Menengah (RKJM) diarahkan secara tajam pada penguatan tata kelola kelembagaan dan eskalasi profesionalitas pendidik. Orientasi kebijakan ini diyakini mampu menghadirkan ekosistem layanan pendidikan yang lebih inklusif, adaptif terhadap perubahan, dan secara konsisten bergerak selaras dengan arah kebijakan pemenuhan Standar Nasional Pendidikan.'
      ],
      tables: [],
      references: []
    });

    // 2.3 Analisis Prioritas
    const prioritasData = analisisData.prioritas || [];
    const prioritasExplanations: string[] = [];
    const consolidatedForPrioritas = consolidateEvidence(analisisData);
    const prioritasContexts = consolidatedForPrioritas.map((c: any) => extractAdministrativeContext(c.isu + ' ' + c.akar + ' ' + c.benahi));
    const prioritasParagraphs = generateStrategicNarrative(prioritasContexts);
    
    prioritasParagraphs.push('Keterangan: Skor prioritas merupakan hasil normalisasi analisis berdasarkan tingkat kesenjangan indikator, urgensi penanganan, serta dampaknya terhadap mutu pendidikan. Semakin tinggi skor, semakin tinggi prioritas penanganan.');
    
    if (prioritasExplanations.length > 0) {
      prioritasParagraphs.push('Keterangan Tambahan Analisis Prioritas:');
      prioritasParagraphs.push(...prioritasExplanations);
    }

    sections.push({
      id: generateId('DocumentSection'),
      title: '2.3 Analisis Prioritas',
      paragraphs: prioritasParagraphs,
      tables: [{
        title: 'Matriks Isu Prioritas',
        data: (() => {
          const consolidated = consolidateEvidence(analisisData);
          if (consolidated.length === 0) return [];
          return consolidated.map(c => ({
            'Isu Prioritas': formatCell(c.isu, 'Isu Prioritas', prioritasExplanations, 15),
            'Skor Prioritas': formatCell(c.skor.toString(), 'Skor Prioritas', prioritasExplanations, 10),
            'Akar Masalah': formatCell(c.akar, 'Akar Masalah', prioritasExplanations, 15)
          }));
        })()
      }],
      references: []
    });

    // 2.4 Analisis SWOT
    const swotExplanations: string[] = [];
    const swotParagraphs = [
      'Sebagai upaya untuk mengontekstualisasikan temuan evaluasi internal dengan dinamika lingkungan eksternal, satuan pendidikan mengadopsi instrumen Analisis SWOT secara komprehensif. Pendekatan ini memfasilitasi tim pengembang sekolah dalam memetakan kapasitas institusional secara objektif, menyandingkan antara kekuatan (strengths) dan kelemahan (weaknesses) internal dengan ragam peluang (opportunities) dan ancaman (threats) yang bersumber dari luar. Pemindaian ekosistem yang terintegrasi ini sangat fundamental untuk memastikan bahwa rancangan pengembangan sekolah memiliki tingkat relevansi yang tinggi dengan kebutuhan masyarakat, perkembangan teknologi, serta arah kebijakan pendidikan daerah maupun nasional yang senantiasa mengalami perubahan secara dinamis.',
      'Dalam penerapannya, setiap elemen SWOT diurai dan disintesis secara sistematis guna merumuskan postur strategi yang tangguh dan adaptif. Modalitas kekuatan internal serta berbagai peluang eksternal dikonsolidasikan secara sinergis agar dapat dimaksimalkan sebagai instrumen akselerator peningkatan mutu layanan. Pada saat yang bersamaan, satuan pendidikan juga menyiapkan skenario mitigasi yang terukur untuk mereduksi dampak negatif dari kelemahan manajerial maupun potensi ancaman eksternal. Orkestrasi dari keempat kuadran analisis ini memastikan bahwa langkah strategis yang akan diambil oleh sekolah tidak hanya berorientasi pada pertumbuhan, tetapi juga dibekali dengan ketahanan kelembagaan yang mumpuni.'
    ];
    sections.push({
      id: generateId('DocumentSection'),
      title: '2.4 Analisis SWOT',
      paragraphs: swotParagraphs,
      tables: [{
        title: 'Matriks Analisis SWOT',
        data: (() => {
           const prioritasLen = analisisData.prioritas ? analisisData.prioritas.length : 0;
           const kekuatanLen = analisisData.kekuatan ? analisisData.kekuatan.length : 0;
           const kelemahanLen = analisisData.kelemahan ? analisisData.kelemahan.length : 0;
           const isEmptyProfile = prioritasLen === 0 && kekuatanLen === 0 && kelemahanLen === 0;
           return [{
             'Kekuatan (Strengths)': formatCell(synthesizeSWOT((analisisData.kekuatan || []).map((s:any) => typeof s === 'string' ? s : s.name || ''), 'Kekuatan', isEmptyProfile), 'Kekuatan', swotExplanations, 15),
             'Kelemahan (Weaknesses)': formatCell(synthesizeSWOT((analisisData.kelemahan || []).map((s:any) => typeof s === 'string' ? s : s.name || ''), 'Kelemahan', isEmptyProfile), 'Kelemahan', swotExplanations, 15),
             'Peluang (Opportunities)': formatCell(synthesizeSWOT((analisisData.peluang || []).map((s:any) => typeof s === 'string' ? s : s.name || ''), 'Peluang', isEmptyProfile), 'Peluang', swotExplanations, 15),
             'Ancaman (Threats)': formatCell(synthesizeSWOT((analisisData.tantangan || []).map((s:any) => typeof s === 'string' ? s : s.name || ''), 'Ancaman', isEmptyProfile), 'Ancaman', swotExplanations, 15)
           }];
        })()
      }],
      references: []
    });
    if (swotExplanations.length > 0) {
      swotParagraphs.push('Keterangan Tambahan Analisis SWOT:');
      swotParagraphs.push(...swotExplanations);
    }

    // 2.5 Analisis IRB
    const irbExplanations: string[] = [];
    const consolidatedIRB = consolidateEvidence(analisisData);
    const irbContexts = consolidatedIRB.map((c: any) => extractAdministrativeContext(c.isu + ' ' + c.akar + ' ' + c.benahi));
    const irbParagraphs = generateAdministrativeNarrative(irbContexts);

    sections.push({
      id: generateId('DocumentSection'),
      title: '2.5 Analisis IRB',
      paragraphs: irbParagraphs,
      tables: [{
        title: 'Matriks Identifikasi, Refleksi, dan Benahi',
        data: (() => {
          if (consolidatedIRB.length === 0) return [];
          return consolidatedIRB.map(c => ({
            'Identifikasi (Identification)': formatCell(c.isu, 'Identifikasi', irbExplanations, 15),
             'Refleksi (Reflection)': formatCell(c.akar, 'Refleksi', irbExplanations, 15),
             'Tindakan Benahi (Improvement)': formatCell(c.benahi, 'Tindakan Benahi', irbExplanations, 15)
          }));
        })()
      }],
      references: []
    });
    if (irbExplanations.length > 0) {
      irbParagraphs.push('Keterangan Tambahan Analisis IRB:');
      irbParagraphs.push(...irbExplanations);
    }

    // 2.6 Prioritas Strategis
    const stratExplanations: string[] = [];
    const consolidatedStrat = consolidateEvidence(analisisData);
    const stratContexts = consolidatedStrat.map((c: any) => extractAdministrativeContext(c.isu + ' ' + c.akar + ' ' + c.benahi + ' ' + c.sasaran));
    const stratParagraphs = generateFinalNarrative(stratContexts);
    sections.push({
      id: generateId('DocumentSection'),
      title: '2.6 Prioritas Strategis',
      paragraphs: stratParagraphs,
      tables: [{
        title: 'Ringkasan Prioritas Strategis',
        data: (() => {
          const consolidated = consolidateEvidence(analisisData);
          if (consolidated.length === 0) return [];
          return consolidated.map(c => ({
             'Sasaran / Prioritas (Objective)': formatCell(c.sasaran, 'Sasaran', stratExplanations, 15),
             'Program Aksi (Program)': formatCell(c.benahi, 'Program', stratExplanations, 15),
             'Indikator Keberhasilan': formatCell(c.indikator, 'Indikator', stratExplanations, 15)
          }));
        })()
      }],
      references: []
    });
    if (stratExplanations.length > 0) {
      stratParagraphs.push('Keterangan Tambahan Prioritas Strategis:');
      stratParagraphs.push(...stratExplanations);
    }

    // 2.7 Kesimpulan BAB II
    sections.push({
      id: generateId('DocumentSection'),
      title: '2.7 Kesimpulan Bab II',
      paragraphs: [
        'Keseluruhan rangkaian analisis yang telah diuraikan dalam bab ini secara tegas mengonfirmasi bahwa arsitektur perencanaan strategis satuan pendidikan kami dibangun di atas fondasi data yang kuat dan penelusuran masalah yang sangat komprehensif. Proses diagnostik yang melibatkan evaluasi Rapor Pendidikan, telaah kekuatan dan kelemahan institusional, hingga identifikasi akar masalah melalui siklus IRB, membuktikan keseriusan manajemen sekolah dalam mendiagnosa kondisi objektif lembaga. Setiap rumusan strategi yang dihasilkan bukanlah sekadar asumsi, melainkan manifestasi dari komitmen profesional kami untuk menyelesaikan berbagai kendala operasional dan akademik secara terukur, sistemik, dan akuntabel.',
        'Hasil dari pemetaan kondisi internal maupun eksternal ini secara substansial telah menyediakan pijakan rasional yang sangat krusial bagi langkah sekolah ke depan. Sintesis diagnostik ini akan digunakan secara konsisten sebagai rujukan utama dalam mendesain ragam intervensi spesifik, yang akan dielaborasi lebih lanjut ke dalam taksonomi program kerja dan proyeksi kebutuhan anggaran. Melalui koherensi antara hasil analisis pada Bab II dengan rencana aksi pada Bab III dan Bab IV, dokumen Rencana Kerja Jangka Menengah (RKJM) ini diharapkan mampu menjadi dokumen tata kelola yang benar-benar implementatif dan berdaya guna tinggi.'
      ],
      references: []
    });

    return {
      id: generateId('DocumentChapter'),
      title: 'BAB II: Analisis Kondisi Sekolah',
      sections,
      paragraphs: [],
      tables: [],
      figures: [],
      references: allReferences,
      metadata: { generated: true }
    };
  }
}



